# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Local AI (Ollama) ------------------------------------------------------
# Defaults to Ollama running on this Mac. For Vercel, set this to an HTTPS
# gateway that you control; do not expose Ollama's port directly to the web.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional shared secret that the HTTPS gateway verifies before forwarding.
OLLAMA_GATEWAY_TOKEN=
OLLAMA_COACH_MODEL=qwen3:14b
OLLAMA_SCAN_MODEL=gemma3:12b
# Keep models warm between requests. A larger context costs more unified memory.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_WINDOW=16384

# --- Analytics (optional) ---------------------------------------------------
# PostHog product analytics. If unset, the app runs fine with analytics OFF.
# Create a free project at https://posthog.com and copy the Project API key.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# Region host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Wearables (optional) ---------------------------------------------------
# Oura OAuth — register a free app at https://cloud.ouraring.com/oauth/applications
# with redirect URI <your-site>/api/wearables/oura/callback. Unset = "not configured".
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
