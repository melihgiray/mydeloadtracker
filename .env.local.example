# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Anthropic --------------------------------------------------------------
# Used server-side only by the AI coach API route. Never expose this client-side.
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional: override the model used by the coach.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: price the two AI surfaces separately. Both fall back to
# ANTHROPIC_MODEL. The scanner is image-token bound and does constrained
# extraction; the coach reasons over long context and is quality-sensitive.
ANTHROPIC_SCAN_MODEL=
ANTHROPIC_COACH_MODEL=

# --- Local AI (Ollama), optional -------------------------------------------
# Setting a base URL turns on local-first with an automatic cloud fallback.
# Leaving it unset keeps everything on the Anthropic API, which is what
# production does today: a Vercel function cannot reach a Mac on localhost,
# so this needs an authenticated HTTPS gateway before it works in the cloud.
# Never expose Ollama's port to the internet directly.
OLLAMA_BASE_URL=
OLLAMA_GATEWAY_TOKEN=
OLLAMA_COACH_MODEL=gemma4:12b
OLLAMA_SCAN_MODEL=gemma4:12b
OLLAMA_PLAN_MODEL=
# Keep the model warm between requests. A cold load measured ~12.7s.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_WINDOW=16384

# Per-surface override: local | cloud. Empty means follow OLLAMA_BASE_URL.
# Pin the scanner to cloud until a real gym benchmark passes. A wrong but
# confident reading is valid JSON, so the fallback cannot catch it.
AI_SCAN_PROVIDER=
AI_COACH_PROVIDER=
# The planner does NOT follow OLLAMA_BASE_URL and must be named explicitly.
# A plan is a one-shot non-streaming call of 1,600 to 2,600 output tokens,
# measured at 80 to 95 seconds locally, so it is development-only. It is also
# the worst cost target here: a plan is built about once per mesocycle.
AI_PLAN_PROVIDER=

# --- Analytics (optional) ---------------------------------------------------
# PostHog product analytics. If unset, the app runs fine with analytics OFF.
# Create a free project at https://posthog.com and copy the Project API key.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# Region host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Wearables (optional) ---------------------------------------------------
# Oura OAuth — register a free app at https://cloud.ouraring.com/oauth/applications
# with redirect URI <your-site>/api/wearables/oura/callback. Unset = "not configured".
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
